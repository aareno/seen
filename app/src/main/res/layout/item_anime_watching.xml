<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/colorPrimary"
    app:cardUseCompatPadding="false">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageButton
            android:id="@+id/btn_delete"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/trash"
            android:scaleType="centerCrop"
            android:contentDescription="Delete"
            app:tint="@color/red" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:id="@+id/anime_cover"
                android:layout_width="80dp"
                android:layout_height="120dp"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="24dp">

                <!-- Days of week indicator -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/day_mon"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:text="M"
                            android:textSize="8sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/day_indicator_background"/>

                        <TextView
                            android:id="@+id/day_tue"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:text="T"
                            android:textSize="8sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/day_indicator_background"/>

                        <TextView
                            android:id="@+id/day_wed"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:text="W"
                            android:textSize="8sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/day_indicator_background"/>

                        <TextView
                            android:id="@+id/day_thu"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:text="T"
                            android:textSize="8sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/day_indicator_background"/>

                        <TextView
                            android:id="@+id/day_fri"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:text="F"
                            android:textSize="8sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/day_indicator_background"/>

                        <TextView
                            android:id="@+id/day_sat"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:text="S"
                            android:textSize="8sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/day_indicator_background"/>

                        <TextView
                            android:id="@+id/day_sun"
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:text="S"
                            android:textSize="8sp"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:background="@drawable/day_indicator_background"/>
                    </LinearLayout>
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/anime_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginEnd="48dp"
                    android:text="Anime Title"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                    <Button
                        android:id="@+id/btn_minus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="-"
                        android:backgroundTint="#B0BEC5"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="20sp"/>

                    <TextView
                        android:id="@+id/tv_episode_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="16dp"
                        android:text="0"
                        android:textColor="@color/white"
                        android:textSize="17sp"/>

                    <Button
                        android:id="@+id/btn_plus"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="+"
                        android:backgroundTint="#2196F3"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="20sp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Progress section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp"
            android:paddingBottom="8dp"
            android:paddingTop="16dp"
            android:layout_alignParentBottom="true"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp">

            <ProgressBar
                android:id="@+id/progress_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:progress="0"
                android:progressTint="#4CAF50"/>

            <TextView
                android:id="@+id/tv_progress_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="0/0"
                android:textColor="@color/white"
                android:textSize="14sp"/>
        </LinearLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>